# =====================================================================
#  Soporte TI Produbanco — Variables de entorno
#  Copia este archivo a .env (scripts/bootstrap.* lo hace automáticamente
#  y genera los secretos que estén vacíos).
# =====================================================================

# ========== SUPABASE ==========
# URL pública (Kong). Desde dentro de la red Docker los servicios usan
# http://supabase-kong:8000 (se sobreescribe en docker-compose.yml).
SUPABASE_URL=http://localhost:54321
# Se generan con bootstrap (JWT HS256 firmados con SUPABASE_JWT_SECRET)
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# Mínimo 32 caracteres. Si lo cambias después del primer arranque,
# regenera también ANON y SERVICE_ROLE keys.
SUPABASE_JWT_SECRET=
SUPABASE_DB_URL=postgresql://postgres:postgres@localhost:54322/postgres

# --- Infraestructura Supabase self-hosted ---
POSTGRES_PASSWORD=postgres
JWT_EXPIRY=3600
# URL pública del API (para callbacks OAuth y enlaces de email)
API_EXTERNAL_URL=http://localhost:54321
# URL del portal (redirect tras login)
SITE_URL=http://localhost:3000
ADDITIONAL_REDIRECT_URLS=http://localhost:5173
DISABLE_SIGNUP=false
ENABLE_EMAIL_AUTOCONFIRM=true
# Secretos internos (se generan con bootstrap)
SECRET_KEY_BASE=
PG_META_CRYPTO_KEY=
STUDIO_DEFAULT_ORGANIZATION=Produbanco
STUDIO_DEFAULT_PROJECT=Soporte TI

# --- Azure AD / Microsoft Entra ID (SSO) ---
AZURE_ENABLED=false
AZURE_CLIENT_ID=
AZURE_CLIENT_SECRET=
# https://login.microsoftonline.com/<TENANT_ID>
AZURE_URL=https://login.microsoftonline.com/common

# --- Usuario administrador de demostración (creado por bootstrap) ---
DEMO_ADMIN_EMAIL=admin@soporte.local
DEMO_ADMIN_PASSWORD=Admin123!

# ========== REDIS ==========
REDIS_URL=redis://localhost:6379/0
REDIS_STREAM_INGEST=documents.ingest
REDIS_CACHE_TTL=3600
# Worker de ingesta (Redis Streams)
REDIS_CONSUMER_GROUP=ingest-workers
WORKER_ENABLED=true
WORKER_MAX_ATTEMPTS=3
MAX_UPLOAD_MB=50
CONTEXTUAL_EMBEDDINGS=true
# Outbox: documentos registrados por las Edge Functions (Fase 5)
OUTBOX_ENABLED=true
OUTBOX_INTERVAL_SECONDS=15
OUTBOX_STALE_SECONDS=300

# ========== LLM ==========
LLM_PROVIDER=ollama
OLLAMA_HOST=http://ollama:11434
# gemma4:31b-cloud: plan gratuito de Ollama Cloud (requiere 'ollama signin', con límites de uso por hora/semana).
# Alternativa 100% local y sin límites (más lenta sin GPU): qwen3:4b-instruct
OLLAMA_MODEL=gemma4:31b-cloud
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# ========== EMBEDDINGS ==========
EMBEDDING_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
EMBEDDING_DIM=384
# MiniLM trunca a 128 tokens por defecto; 700 caracteres en español ~175 tokens
EMBEDDING_MAX_SEQ_LENGTH=256

# ========== RAG ==========
CHUNK_SIZE=700
CHUNK_OVERLAP=120
TOP_K_RETRIEVAL=20
TOP_K_RERANK=5
SIMILARITY_THRESHOLD=0.35
RERANK_ENABLED=true
# Multilingüe (incluye español). ms-marco-MiniLM-L-6-v2 solo está entrenado en inglés: 6/15 vs 8/15 relevantes en top-5 en la prueba de la Fase 2
RERANK_MODEL=cross-encoder/mmarco-mMiniLMv2-L12-H384-v1

# ========== MICROSERVICIOS ==========
API_GATEWAY_HOST=0.0.0.0
API_GATEWAY_PORT=8000
RAG_SERVICE_URL=http://rag-service:8001
INGEST_SERVICE_URL=http://ingest-service:8002
ANALYTICS_SERVICE_URL=http://analytics-service:8003
# bootstrap lo reemplaza por un valor aleatorio si conserva el valor por defecto
INTERNAL_API_KEY=cambiar-en-produccion
# Gateway: orígenes del portal y límites por usuario (sintaxis N/second|minute|hour|day)
CORS_ORIGINS=http://localhost:3000,http://localhost:5173
RATE_LIMIT_QUERY=20/minute
RATE_LIMIT_UPLOAD=10/minute
RATE_LIMIT_EXPORT=5/minute
RATE_LIMIT_DEFAULT=120/minute
PROFILE_CACHE_TTL=60
# Desde Docker hacia el Ollama nativo del host (modelos *-cloud con 'ollama signin')
OLLAMA_HOST_DOCKER=http://host.docker.internal:11434

# ========== FRONTEND ==========
VITE_SUPABASE_URL=http://localhost:54321
VITE_SUPABASE_ANON_KEY=
VITE_API_GATEWAY_URL=http://localhost:8000
VITE_APP_NAME=Soporte TI Produbanco

# ========== TEAMS BOT ==========
MICROSOFT_APP_ID=
MICROSOFT_APP_PASSWORD=
MICROSOFT_APP_TENANT_ID=
BOT_PORT=3978
BACKEND_URL=http://api-gateway:8000
# Correo con el que actúa el bot si Teams no informa el del usuario (Emulator / pruebas)
BOT_DEFAULT_USER_EMAIL=
# URL pública del túnel (ngrok) para el endpoint de mensajería en Azure Bot Service
BOT_PUBLIC_URL=

# ========== OBSERVABILIDAD ==========
LOG_LEVEL=INFO
ENABLE_TRACING=true
JAEGER_ENDPOINT=http://jaeger:4318/v1/traces
ENABLE_RAGAS=true

# ========== EDGE FUNCTIONS (Fase 5) ==========
# Lo genera scripts/configure_edge_functions.py (secreto compartido trigger SQL -> función)
TFM_WEBHOOK_SECRET=
# Opcional: URL pública del ingest-service para encolar al instante (si no, lo hace el outbox)
INGEST_PUBLIC_URL=
